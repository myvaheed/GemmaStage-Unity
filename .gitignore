# =============================================================================
# GemmaWalker — .gitignore
# =============================================================================

# --- Build outputs ---
build/
bin/
obj/
out/
dist/
*.dll
*.lib
*.exp
*.pdb
*.obj
# PDFtoImage stack (PDFium + SkiaSharp) is shipped with the Unity project
# even though *.dll is otherwise ignored.
!GS.Unity/GemmaStage/Assets/Plugins/NuGet/PDFtoImage.*/PDFtoImage.dll
!GS.Unity/GemmaStage/Assets/Plugins/NuGet/SkiaSharp.*/SkiaSharp.dll
!GS.Unity/GemmaStage/Assets/Plugins/NuGet/SkiaSharp.NativeAssets.Win32.*/libSkiaSharp.dll
!GS.Unity/GemmaStage/Assets/Plugins/NuGet/bblanchon.PDFium.Win32.*/pdfium.dll
*.o
*.a
*.so
*.dylib
*.exe

# --- Models & large binary assets ---
# (downloaded at runtime, never committed)
models/
*.litertlm
*.gguf
*.onnx
*.tflite
*.bin

# --- IDE / Editor ---
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
*.swp
*.swo
*~

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- CMake (for VoxCPM.cpp standalone builds) ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# --- Unity ---
# Auto-generated IDE project files. Unity rewrites these on every IDE refresh,
# so committing them just produces churn. Path-scoped to the Unity project so
# the hand-authored session-module csprojs at the repo root stay tracked.
GS.Unity/GemmaStage/*.csproj
GS.Unity/GemmaStage/*.slnx
GS.Unity/GemmaStage/*.sln
GS.Unity/GemmaStage/*.unityproj
GS.Unity/GemmaStage/*.pidb
GS.Unity/GemmaStage/*.booproj

# --- Misc ---
*.log
*.tmp
*.bak
*.cache

.agents/
.claude/
.mcp.json

.dotnet/

# SmokeTest resources
GemmaStage.Session.SmokeTest/res/

Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/
EXAMPLES/
Packages/
Rocketbox/
Recordings/

# Editor-only board capture dumps (Phase 4.3.2 dev hook)
_capture_dumps/